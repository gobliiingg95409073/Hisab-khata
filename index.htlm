<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>व्यापार और लेबर हिसाब-किताब ऐप</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen pb-24">

    <!-- App Bar Header -->
    <header class="bg-gradient-to-r from-violet-600 to-indigo-600 text-white p-4 sticky top-0 z-50 shadow-lg flex justify-between items-center">
        <div>
            <h1 class="text-lg font-bold flex items-center gap-2">📊 लेबर & व्यापार हिसाब</h1>
            <p class="text-xs text-violet-200">दैनिक और साप्ताहिक खर्च मैनेजर</p>
        </div>
        <div class="flex gap-2">
            <button onclick="resetData()" class="bg-red-500/80 hover:bg-red-600 text-white text-xs px-2.5 py-1.5 rounded-lg font-medium transition backdrop-blur-sm">रीसेट</button>
            <button onclick="window.print()" class="bg-white/20 hover:bg-white/30 text-white text-xs px-2.5 py-1.5 rounded-lg font-medium transition backdrop-blur-sm">प्रिंट</button>
        </div>
    </header>

    <main class="max-w-xl mx-auto p-4 space-y-4">
        
        <!-- Summary Dashboard Cards -->
        <div class="grid grid-cols-2 gap-3">
            <div class="bg-slate-800 p-3.5 rounded-2xl border border-slate-700/60 shadow-sm">
                <span class="block text-[11px] font-medium text-slate-400 uppercase">शुरुआती बैलेंस (Opening)</span>
                <input type="number" id="openingBalance" value="25000" onchange="calculateTotals()" class="w-full text-lg font-bold mt-1 bg-slate-900/50 text-white p-2 border border-slate-700 rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none">
            </div>
            <div class="bg-slate-800 p-3.5 rounded-2xl border border-slate-700/60 shadow-sm flex flex-col justify-between">
                <span class="block text-[11px] font-medium text-slate-400 uppercase">बचा हुआ (Closing)</span>
                <div id="closingBalanceDisplay" class="text-xl font-bold text-emerald-400 mt-1">₹0</div>
            </div>
        </div>

        <!-- Total Expense Banner -->
        <div class="bg-gradient-to-r from-slate-800 to-slate-800/80 p-3.5 rounded-2xl border border-slate-700/60 flex justify-between items-center shadow-sm">
            <span class="text-sm font-medium text-slate-300">कुल खर्च (Total Expense):</span>
            <div id="totalExpenseDisplay" class="text-xl font-bold text-rose-400">₹0</div>
        </div>

        <!-- Daily Entries Container -->
        <div class="space-y-3 pt-2">
            <div class="flex justify-between items-center px-1">
                <h2 class="text-sm font-semibold text-slate-300 tracking-wide uppercase">दैनिक प्रविष्टियाँ (Entries)</h2>
                <span class="text-xs text-slate-400" id="rowCount">0 दिन</span>
            </div>

            <!-- List of Entries injected dynamically -->
            <div id="entriesList" class="space-y-3">
                <!-- Cards will load here -->
            </div>
        </div>
    </main>

    <!-- Floating Action Button (FAB) for Mobile App Feel -->
    <div class="fixed bottom-6 right-6 z-50">
        <button onclick="addRow()" class="bg-gradient-to-r from-violet-600 to-indigo-600 hover:from-violet-500 hover:to-indigo-500 text-white font-bold p-4 rounded-full shadow-2xl flex items-center justify-center transition transform active:scale-95 border border-violet-400/30">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"></path></svg>
        </button>
    </div>

    <!-- JavaScript Logic -->
    <script>
        let defaultRows = [
            { day: "सोमवार (1 तारीख)", sardar: 1500, vehicle: 400, other: 100, labour: 0 },
            { day: "मंगलवार (2 तारीख)", sardar: 1500, vehicle: 0, other: 50, labour: 3500 },
            { day: "बुधवार (3 तारीख)", sardar: 1500, vehicle: 600, other: 0, labour: 0 },
            { day: "गुरुवार (4 तारीख)", sardar: 1500, vehicle: 0, other: 200, labour: 4000 },
            { day: "शुक्रवार (5 तारीख)", sardar: 1500, vehicle: 500, other: 0, labour: 0 },
            { day: "शनिवार (6 तारीख)", sardar: 1500, vehicle: 300, other: 150, labour: 4500 },
            { day: "रविवार (7 तारीख)", sardar: 1500, vehicle: 0, other: 0, labour: 0 }
        ];

        let entries = JSON.parse(localStorage.getItem('ledgerEntriesApp')) || defaultRows;
        let openingInput = document.getElementById('openingBalance');
        openingInput.value = localStorage.getItem('openingBalanceApp') || 25000;

        function renderList() {
            const container = document.getElementById('entriesList');
            container.innerHTML = '';
            document.getElementById('rowCount').innerText = `${entries.length} दिन`;

            entries.forEach((row, index) => {
                let dailyTotal = Number(row.sardar || 0) + Number(row.vehicle || 0) + Number(row.other || 0) + Number(row.labour || 0);
                
                let card = document.createElement('div');
                card.className = "bg-slate-800 p-4 rounded-2xl border border-slate-700/60 shadow-md space-y-3 relative transition";
                card.innerHTML = `
                    <div class="flex justify-between items-center gap-2">
                        <input type="text" value="${row.day}" oninput="updateData(${index}, 'day', this.value)" class="bg-slate-900/60 text-slate-200 font-semibold px-3 py-1.5 rounded-xl border border-slate-700 text-sm w-full outline-none focus:border-indigo-500">
                        <button onclick="deleteRow(${index})" class="text-slate-400 hover:text-red-400 p-1.5 transition">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                        </button>
                    </div>

                    <div class="grid grid-cols-2 gap-2 text-xs">
                        <div>
                            <label class="text-slate-400 block mb-1">सरदार खाना (₹)</label>
                            <input type="number" value="${row.sardar}" oninput="updateData(${index}, 'sardar', this.value)" class="w-full bg-slate-900/50 p-2 border border-slate-700 rounded-xl text-slate-200 font-medium outline-none focus:ring-1 focus:ring-indigo-500">
                        </div>
                        <div>
                            <label class="text-slate-400 block mb-1">गाड़ी/पेट्रोल (₹)</label>
                            <input type="number" value="${row.vehicle}" oninput="updateData(${index}, 'vehicle', this.value)" class="w-full bg-slate-900/50 p-2 border border-slate-700 rounded-xl text-slate-200 font-medium outline-none focus:ring-1 focus:ring-indigo-500">
                        </div>
                        <div>
                            <label class="text-slate-400 block mb-1">अन्य खर्च (₹)</label>
                            <input type="number" value="${row.other}" oninput="updateData(${index}, 'other', this.value)" class="w-full bg-slate-900/50 p-2 border border-slate-700 rounded-xl text-slate-200 font-medium outline-none focus:ring-1 focus:ring-indigo-500">
                        </div>
                        <div>
                            <label class="text-slate-400 block mb-1">लेबर पेमेंट (₹)</label>
                            <input type="number" value="${row.labour}" oninput="updateData(${index}, 'labour', this.value)" class="w-full bg-slate-900/50 p-2 border border-slate-700 rounded-xl text-indigo-400 font-bold outline-none focus:ring-1 focus:ring-indigo-500">
                        </div>
                    </div>

                    <div class="flex justify-between items-center pt-2 border-t border-slate-700/50 text-xs">
                        <span class="text-slate-400 font-medium">दैनिक कुल खर्च:</span>
                        <span class="text-sm font-bold text-slate-200">₹${dailyTotal.toLocaleString()}</span>
                    </div>
                `;
                container.appendChild(card);
            });
            calculateTotals();
        }

        function updateData(index, field, value) {
            entries[index][field] = value;
            saveAndRender();
        }

        function addRow() {
            entries.push({ day: "नया दिन", sardar: 1500, vehicle: 0, other: 0, labour: 0 });
            saveAndRender();
        }

        function deleteRow(index) {
            if(confirm('क्या आप इस दिन का रिकॉर्ड हटाना चाहते हैं?')) {
                entries.splice(index, 1);
                saveAndRender();
            }
        }

        function calculateTotals() {
            let totalExp = 0;
            entries.forEach(row => {
                totalExp += Number(row.sardar || 0) + Number(row.vehicle || 0) + Number(row.other || 0) + Number(row.labour || 0);
            });

            let opening = Number(openingInput.value || 0);
            let closing = opening - totalExp;

            document.getElementById('totalExpenseDisplay').innerText = `₹${totalExp.toLocaleString()}`;
            let closingElem = document.getElementById('closingBalanceDisplay');
            closingElem.innerText = `₹${closing.toLocaleString()}`;
            closingElem.className = closing >= 0 ? "text-xl font-bold text-emerald-400 mt-1" : "text-xl font-bold text-rose-400 mt-1";

            localStorage.setItem('openingBalanceApp', opening);
        }

        function saveAndRender() {
            localStorage.setItem('ledgerEntriesApp', JSON.stringify(entries));
            renderList();
        }

        function resetData() {
            if(confirm('क्या आप सारा डेटा रीसेट करना चाहते हैं?')) {
                localStorage.clear();
                entries = defaultRows;
                openingInput.value = 25000;
                saveAndRender();
            }
        }

        // Initial Load
        renderList();
    </script>
</body>
</html>
      
